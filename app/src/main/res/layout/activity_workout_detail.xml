<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".WorkoutDetailActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/detailDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="September 11"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/bricolage_grotesque" />

            <TextView
                android:id="@+id/detailTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chest + Biceps"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/sora_semibold" />

            <TextView
                android:id="@+id/detailDurationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="45 min"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/bricolage_grotesque"
                android:visibility="gone" />

            <TextView
                android:id="@+id/detailNotesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@color/surface"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/bricolage_grotesque"
                android:visibility="gone" />

            <Button
                android:id="@+id/copyWorkoutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="COPY AS TEXT"
                android:textColor="@color/primary"
                android:fontFamily="@font/bricolage_grotesque"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/editWorkoutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT WORKOUT"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/bricolage_grotesque"
                style="?android:attr/borderlessButtonStyle" />

            <LinearLayout
                android:id="@+id/detailExercisesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>