<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".WorkoutActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/workoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/workoutScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Workout Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/sora_semibold" />

        <TextView
            android:id="@+id/workoutTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="00:00"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/bricolage_grotesque" />

        <Button
            android:id="@+id/finishWorkoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINISH"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:fontFamily="@font/bricolage_grotesque"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exerciseRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/breakTimerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="16dp"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:clipChildren="false">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/breakProgressIndicator"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/background"
                app:trackThickness="4dp"
                app:indicatorSize="64dp" />

            <TextView
                android:id="@+id/breakTimerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0:30"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/bricolage_grotesque" />

        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Break in progress"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/bricolage_grotesque" />

        <Button
            android:id="@+id/cancelBreakButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/bricolage_grotesque"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

    <Button
        android:id="@+id/breakButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:text="⏱ BREAK"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/bricolage_grotesque" />

</LinearLayout>