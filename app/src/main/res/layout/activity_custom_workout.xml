<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CustomWorkoutActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/customWorkoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <EditText
        android:id="@+id/customTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Workout title"
        android:text="Custom Workout"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@color/surface"
        android:padding="12dp"
        android:fontFamily="@font/sora_semibold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/customExercisesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/addCustomExerciseButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:text="+ ADD EXERCISE"
        android:textColor="@color/primary"
        android:fontFamily="@font/bricolage_grotesque"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/startCustomWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:text="START WORKOUT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/bricolage_grotesque" />

</LinearLayout>