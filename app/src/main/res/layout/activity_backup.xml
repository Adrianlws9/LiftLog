<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".BackupActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/backupToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Data"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/sora_semibold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Save all your workout history and plan to a file you can keep safe or move to a new device."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/bricolage_grotesque" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="EXPORT TO FILE"
            android:textColor="@color/background"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/bricolage_grotesque" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="32dp"
            android:background="@color/surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Data"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/sora_semibold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚠️ Only import onto a fresh install. Importing twice, or onto data that already exists, will create duplicates."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/bricolage_grotesque" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="IMPORT FROM FILE"
            android:textColor="@color/text_secondary"
            style="?android:attr/borderlessButtonStyle"
            android:fontFamily="@font/bricolage_grotesque" />

    </LinearLayout>

</LinearLayout>