<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/surface"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bodyWeightValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75 kg"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/sora_semibold" />

        <TextView
            android:id="@+id/bodyWeightDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="September 24"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/bricolage_grotesque" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/deleteBodyWeightButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary"
        android:contentDescription="Delete entry" />

</LinearLayout>